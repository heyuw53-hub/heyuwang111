# Copier ce fichier en .streamlit/secrets.toml (ne jamais le publier sur GitHub).
# Sur Streamlit Community Cloud : coller ce contenu dans App settings > Secrets.

ADMIN_PASSWORD = "changez-moi"

# Optionnel en local (sinon SQLite : tp_data.db).
# Obligatoire en ligne. Exemple Supabase (utiliser l'URL "Session pooler") :
# DATABASE_URL = "postgresql+psycopg2://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"
